<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Runtimes come from DataVoTestTargets (Directory.Build.props): net10.0 locally, all three in CI. -->
    <TargetFrameworks>$(DataVoTestTargets)</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!-- System.Linq.AsyncEnumerable is part of the .NET 10 libraries; earlier runtimes take the package. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <PackageReference Include="System.Linq.AsyncEnumerable" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DataVo.VectorData\DataVo.VectorData.csproj" />
  </ItemGroup>

</Project>
