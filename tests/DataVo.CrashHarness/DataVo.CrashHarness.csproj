<Project Sdk="Microsoft.NET.Sdk">

  <!-- Child process for DataVo.Tests crash-recovery tests: it writes and acknowledges rows until it is
       killed, so the test can verify that every acknowledged write survives a hard crash. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The crash tests start the harness built for their own target framework. -->
    <!-- Runtimes come from DataVoTestTargets (Directory.Build.props): net10.0 locally, all three in CI. -->
    <TargetFrameworks>$(DataVoTestTargets)</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DataVo.Core\DataVo.Core.csproj" />
  </ItemGroup>

</Project>
