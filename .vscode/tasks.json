{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/DataVo.Tests/DataVo.Tests.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "pack",
      "dependsOn": [
        "pack: core",
        "pack: data",
        "pack: efcore",
        "pack: generators",
        "pack: vectordata"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "pack: core",
      "command": "dotnet",
      "type": "process",
      "args": [
        "pack",
        "${workspaceFolder}/DataVo.Core/DataVo.Core.csproj",
        "-c",
        "Release"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "pack: data",
      "command": "dotnet",
      "type": "process",
      "args": [
        "pack",
        "${workspaceFolder}/DataVo.Data/DataVo.Data.csproj",
        "-c",
        "Release"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "pack: efcore",
      "command": "dotnet",
      "type": "process",
      "args": [
        "pack",
        "${workspaceFolder}/DataVo.EntityFrameworkCore/DataVo.EntityFrameworkCore.csproj",
        "-c",
        "Release"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "pack: generators",
      "command": "dotnet",
      "type": "process",
      "args": [
        "pack",
        "${workspaceFolder}/DataVo.Generators/DataVo.Generators.csproj",
        "-c",
        "Release"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "pack: vectordata",
      "command": "dotnet",
      "type": "process",
      "args": [
        "pack",
        "${workspaceFolder}/DataVo.VectorData/DataVo.VectorData.csproj",
        "-c",
        "Release"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "deploy: browser wasm",
      "command": "${workspaceFolder}/scripts/deploy-browser-wasm.sh",
      "type": "process",
      "problemMatcher": "$msCompile"
    }
  ]
}
