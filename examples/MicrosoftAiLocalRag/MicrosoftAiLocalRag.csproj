<Project Sdk="Microsoft.NET.Sdk">

  <!-- Local retrieval-augmented search over DataVo's own manual with the standard .NET AI abstractions:
       Microsoft.Extensions.AI's IEmbeddingGenerator produces the embeddings and Microsoft.Extensions.VectorData's
       VectorStoreCollection (implemented by DataVo.VectorData) stores and searches them. `dotnet run -c Release`
       works offline with the built-in deterministic generator; pass the ollama flag to embed with a local Ollama. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Inside this repository the example builds against the source. Outside it, replace this with
         <PackageReference Include="DataVo.VectorData" Version="0.5.*" />. -->
    <ProjectReference Include="..\..\DataVo.VectorData\DataVo.VectorData.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="11.0.1" />
  </ItemGroup>

</Project>
