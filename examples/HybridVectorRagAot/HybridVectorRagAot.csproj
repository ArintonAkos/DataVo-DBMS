<Project Sdk="Microsoft.NET.Sdk">

  <!-- Single-binary local hybrid search: SQL metadata filters + HNSW vector similarity, published as one Native AOT
       executable with no native .dll/.so/.dylib beside it. `dotnet run` runs it on the JIT; `dotnet publish -c Release
       -r <rid>` produces the native binary (PublishAot is on). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <!-- Publish exactly one file: no .pdb/.dSYM debug side files, no copied XML docs of referenced projects. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <OptimizationPreference>Speed</OptimizationPreference>
  </PropertyGroup>

  <ItemGroup>
    <!-- Inside this repository the example builds against the engine source. Outside it, replace this with
         <PackageReference Include="DataVo.Core" Version="0.5.*" />. -->
    <ProjectReference Include="..\..\DataVo.Core\DataVo.Core.csproj" />
  </ItemGroup>

</Project>
