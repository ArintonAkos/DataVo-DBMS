<Project Sdk="Microsoft.NET.Sdk">

  <!-- Latency and memory of DataVoTable<T> queries against a direct prepared statement and StreamQuery.
       Run it in Release with "dotnet run -c Release", passing an optional row count after the project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);DataVo.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DataVo.Core\DataVo.Core.csproj" />
    <ProjectReference Include="..\..\DataVo.Generators\DataVo.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
