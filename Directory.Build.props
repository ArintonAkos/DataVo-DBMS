<Project>
  <!-- Packaging is strictly opt-in: a project must explicitly set IsPackable=true
       (see the conditional groups below and DataVo.Generators.csproj) to be published.
       This default keeps any future project out of the public NuGet feed by accident. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'DataVo.Core' Or '$(MSBuildProjectName)' == 'DataVo.Data'">
    <IsPackable>true</IsPackable>
    <Version>0.1.0-preview.2</Version>
    <Authors>Arinton Akos</Authors>
    <Company>DataVo</Company>
    <Description>DataVo is a C#-native database engine focused on predictable SQL execution, in-memory and disk-backed storage, and embeddable .NET workflows.</Description>
    <PackageTags>database;sql;dbms;dotnet;csharp;storage;embedded</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ArintonAkos/DataVo-DBMS</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ArintonAkos/DataVo-DBMS.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'DataVo.Core'">
    <PackageId>DataVo.Core</PackageId>
    <Title>DataVo Core</Title>
    <PackageReleaseNotes>SQL engine, storage, indexing, and ALTER TABLE support. preview.2 refreshes the package README and packaging; published via CI Trusted Publishing.</PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'DataVo.Data'">
    <PackageId>DataVo.Data</PackageId>
    <Title>DataVo Data</Title>
    <Description>ADO.NET-facing abstractions and integration layer for the DataVo engine.</Description>
    <PackageReleaseNotes>DataVo data-access package. preview.2 refreshes the package README and packaging.</PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'DataVo.EntityFrameworkCore'">
    <IsPackable>true</IsPackable>
    <Version>0.1.0-preview.2</Version>
    <Authors>Arinton Akos</Authors>
    <Company>DataVo</Company>
    <PackageId>DataVo.EntityFrameworkCore</PackageId>
    <Title>DataVo EntityFrameworkCore</Title>
    <Description>Experimental Entity Framework Core bridge and future provider surface for DataVo.</Description>
    <PackageTags>database;sql;dbms;dotnet;csharp;entityframework;efcore;embedded</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ArintonAkos/DataVo-DBMS</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ArintonAkos/DataVo-DBMS.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReleaseNotes>EF Core schema bridge for generating DataVo DDL from EF models. preview.2 refreshes the package README and packaging.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Link="README.md" Visible="false" />
  </ItemGroup>
</Project>
