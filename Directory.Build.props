<Project>
  <!-- Packaging is strictly opt-in: a project must explicitly set IsPackable=true
       (see the conditional groups below and DataVo.Generators.csproj) to be published.
       This default keeps any future project out of the public NuGet feed by accident. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <!-- The runtimes the test projects (and the crash harness they launch) are built for. Local runs default to
       net10.0 so they work with only the .NET 10 runtime installed; CI sets DataVoTestTargets (an environment
       variable is enough) to "net8.0;net9.0;net10.0" and runs every package target on its own runtime. -->
  <PropertyGroup>
    <DataVoTestTargets Condition="'$(DataVoTestTargets)' == ''">net10.0</DataVoTestTargets>
  </PropertyGroup>

  <!-- Native AOT durable fence: the single list of IL trim/AOT/single-file diagnostics that the AOT-locked
       libraries (DataVo.Core, DataVo.Data, DataVo.VectorData) promote to errors. Each project appends
       $(DataVoAotWarningsAsErrors) to WarningsAsErrors for its AOT-capable targets, so the lists cannot drift.
       Verified by scripts/check-aot-baseline.sh. -->
  <PropertyGroup>
    <DataVoAotWarningsAsErrors>IL2026;IL2046;IL2055;IL2057;IL2060;IL2067;IL2070;IL2072;IL2075;IL2077;IL2080;IL2087;IL2090;IL2091;IL2092;IL2093;IL2095;IL2111;IL3050;IL3051;IL3052;IL3053;IL3054;IL3055;IL3056</DataVoAotWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'DataVo.Core' Or '$(MSBuildProjectName)' == 'DataVo.Data'">
    <IsPackable>true</IsPackable>
    <Version>0.5.1</Version>
    <Authors>Arinton Akos</Authors>
    <Company>DataVo</Company>
    <Description>DataVo is a C#-native database engine focused on predictable SQL execution, in-memory and LSM (log-structured, on-disk) storage, and embeddable .NET workflows.</Description>
    <PackageTags>database;sql;dbms;dotnet;csharp;storage;embedded</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ArintonAkos/DataVo-DBMS</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ArintonAkos/DataVo-DBMS.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'DataVo.Core'">
    <PackageId>DataVo.Core</PackageId>
    <Title>DataVo Core</Title>
    <PackageReleaseNotes>0.5.1: concurrency fixes. Single-row INSERT takes the table intent lock plus key locks instead of the table write lock; UPDATE reserves new primary and unique key values before checking them; CREATE INDEX, DROP INDEX, DROP TABLE and VACUUM take the exclusive table lock; lock-free primary-key point reads follow a moved row; the fixed-width compiled UPDATE fast path also runs in InMemory mode. 0.5.0: net8.0/net9.0/net10.0/netstandard2.1 targets, native DATETIME, EXPLAIN with the executed operator, a sharded LSM block cache, typed reactive top-K and join views, ReadOnlyMemory&lt;float&gt; vectors ([VectorDimensions] models, parameters, SearchNearest), NULL keys held by LSM indexes (index-only GROUP BY counts), and ordinal text comparison on every path. Breaking: the paged Disk storage mode and pre-release on-disk format upgrades were removed; InMemory and Lsm remain.</PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'DataVo.Data'">
    <PackageId>DataVo.Data</PackageId>
    <Title>DataVo Data</Title>
    <Description>ADO.NET-facing abstractions and integration layer for the DataVo engine.</Description>
    <PackageReleaseNotes>DataVo data-access package. 0.5.1 aligns with DataVo.Core 0.5.1; StorageMode in connection strings accepts InMemory or Lsm and rejects anything else.</PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'DataVo.EntityFrameworkCore'">
    <IsPackable>true</IsPackable>
    <Version>0.5.1</Version>
    <Authors>Arinton Akos</Authors>
    <Company>DataVo</Company>
    <PackageId>DataVo.EntityFrameworkCore</PackageId>
    <Title>DataVo EntityFrameworkCore</Title>
    <Description>Experimental Entity Framework Core bridge and future provider surface for DataVo.</Description>
    <PackageTags>database;sql;dbms;dotnet;csharp;entityframework;efcore;embedded</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ArintonAkos/DataVo-DBMS</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ArintonAkos/DataVo-DBMS.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReleaseNotes>EF Core schema bridge for generating DataVo DDL from EF models. 0.5.1 aligns with DataVo.Core 0.5.1; the persistent mode is DataVoStorageMode.Lsm (UseLsmStorage).</PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'DataVo.VectorData'">
    <IsPackable>true</IsPackable>
    <Version>0.5.1</Version>
    <Authors>Arinton Akos</Authors>
    <Company>DataVo</Company>
    <PackageId>DataVo.VectorData</PackageId>
    <Title>DataVo VectorData</Title>
    <Description>Microsoft.Extensions.VectorData provider for DataVo: an embedded, Native AOT compatible vector store with HNSW and FLAT indexes, LINQ filters translated to SQL, and in-memory or LSM persistence.</Description>
    <PackageTags>database;vector;vectordata;embeddings;rag;ai;hnsw;dotnet;embedded</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ArintonAkos/DataVo-DBMS</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ArintonAkos/DataVo-DBMS.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReleaseNotes>First release: VectorStore and VectorStoreCollection over DataVo tables (int, long, Guid and string keys), HNSW/FLAT indexes for cosine and Euclidean distance, ReadOnlyMemory&lt;float&gt;, float[] and Embedding&lt;float&gt; vectors, embedding generation, LINQ filters, dynamic collections and dependency injection.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Link="README.md" Visible="false" />
  </ItemGroup>
</Project>
