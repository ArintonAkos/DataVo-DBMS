<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <Version>$(DataVoVersion)</Version>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Safe since the host dropped Newtonsoft/dynamic: DataVo.Core is trim/AOT-clean and JSON is source-generated. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataVo.Core\DataVo.Core.csproj" />
  </ItemGroup>

  <!-- DataVo.Core is trim/AOT-clean, so the framework is trimmed by analysis alone; the engine and the
       JS-facing host stay fully rooted for [JSExport]/[JSImport] and catalog XML. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="DataVo.Core" />
    <TrimmerRootAssembly Include="DataVo.Browser" />
  </ItemGroup>

  <ItemGroup>
    <None Include="datavo.interop.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="datavo.storage.worker.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>

</Project>
