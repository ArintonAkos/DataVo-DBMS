<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <DataVoCoreTargetFramework Condition="'$(DataVoCoreTargetFramework)' == ''">net10.0</DataVoCoreTargetFramework>
    <OutputPath Condition="'$(DataVoCoreTargetFramework)' == 'netstandard2.1'">bin/$(Configuration)/$(TargetFramework)-datavo-netstandard2.1/</OutputPath>
    <IntermediateOutputPath Condition="'$(DataVoCoreTargetFramework)' == 'netstandard2.1'">obj/$(Configuration)/$(TargetFramework)-datavo-netstandard2.1/</IntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DataVoCoreTargetFramework)' == 'netstandard2.1'">
    <DefineConstants>$(DefineConstants);DATAVO_CORE_NETSTANDARD21</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.5.3" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Research.Benchmark.Abstractions/Research.Benchmark.Abstractions.csproj" />
    <ProjectReference Include="../../../../DataVo.Core/DataVo.Core.csproj" SetTargetFramework="TargetFramework=$(DataVoCoreTargetFramework)" />
  </ItemGroup>

</Project>
