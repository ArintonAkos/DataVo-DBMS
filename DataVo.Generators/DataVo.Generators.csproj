<!-- An application published with -p:PublishAot=true passes that to this analyzer too, and a
     netstandard2.0 library cannot be compiled ahead of time. -->
<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot">
  <PropertyGroup>
    <PublishAot>false</PublishAot>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);RS1036;RS2008;NU5128</NoWarn>
    <Version>0.2.0-rc.2</Version>
    <Authors>Arinton Akos</Authors>
    <Company>DataVo</Company>
    <PackageId>DataVo.Generators</PackageId>
    <Title>DataVo Generators</Title>
    <Description>Source generators for DataVo compiled queries.</Description>
    <PackageTags>database;sql;dbms;dotnet;csharp;source-generator;embedded</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ArintonAkos/DataVo-DBMS</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ArintonAkos/DataVo-DBMS.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts\packages</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Unity 6 compiles with Roslyn 4.10 and will not load an analyzer built against anything newer. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.10.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="build\DataVo.Generators.targets" Pack="true" PackagePath="build" />
    <None Include="build\DataVo.Generators.targets" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>
</Project>
