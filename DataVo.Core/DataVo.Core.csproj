<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <!-- AOT durable fence (Phase 1) — COMPLETE & LOCKED. The trim/AOT analyzers are on and the IL
         trim/AOT diagnostics are errors, so DataVo.Core stays Native-AOT clean: any regression fails the
         build. The baseline was ratcheted 184 -> 0 across the Native AOT cleanup (catalog XmlSerializer,
         Newtonsoft/STJ-reflection -> STJ source-gen, dynamic/DLR removal, Activator factory). -->
    <IsAotCompatible>true</IsAotCompatible>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2055;IL2057;IL2067;IL2070;IL2072;IL2075;IL2080;IL2087;IL2090;IL2091;IL2092;IL2093;IL3050;IL3051;IL3052;IL3053;IL3054;IL3055;IL3056</WarningsAsErrors>
  </PropertyGroup>

</Project>
