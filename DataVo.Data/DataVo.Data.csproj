<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DataVo.Core\DataVo.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;netstandard2.1</TargetFrameworks>
    <DataVoModernTarget>$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))</DataVoModernTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- AOT durable fence: this project is AOT/trim-clean and LOCKED. IsAotCompatible turns on the
         trim/AOT/single-file analyzers; the IL* trim/AOT diagnostics are errors so any regression
         fails the build. Phase 1 of the Native AOT initiative; see docs/superpowers/specs. -->
    <IsAotCompatible Condition="'$(DataVoModernTarget)' == 'true'">true</IsAotCompatible>
    <WarningsAsErrors Condition="'$(DataVoModernTarget)' == 'true'">$(WarningsAsErrors);IL2026;IL2046;IL2055;IL2057;IL2067;IL2070;IL2072;IL2075;IL2080;IL2087;IL2090;IL2091;IL2092;IL2093;IL3050;IL3051;IL3052;IL3053;IL3054;IL3055;IL3056</WarningsAsErrors>
  </PropertyGroup>

</Project>
